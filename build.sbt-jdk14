name := "tlcockpit"

version := "1.3"

scalaVersion := "2.12.20"

// Java 21 (LTS) - bundled with JavaFX, no external dependencies needed
val javaVersion = 21

libraryDependencies += "org.scalafx" %% "scalafx" % "21.0.0-R32"
libraryDependencies += "io.spray" %%  "spray-json" % "1.3.6"
libraryDependencies += "com.typesafe.scala-logging" %% "scala-logging" % "3.9.5"
libraryDependencies += "ch.qos.logback" % "logback-classic" % "1.5.6"
libraryDependencies += "org.json4s" %% "json4s-native" % "3.7.2"
libraryDependencies += "org.json4s" %% "json4s-jackson" % "3.7.2"

lazy val root = (project in file(".")).
  enablePlugins(BuildInfoPlugin).
  settings(
    buildInfoKeys := Seq[BuildInfoKey](name, version, scalaVersion, sbtVersion, BuildInfoKey(("javaVersion", javaVersion))),
    buildInfoPackage := "TLCockpit",
    buildInfoOptions += sbtbuildinfo.BuildInfoOption.ToOnInit
  )

mainClass in assembly := Some("TLCockpit.ApplicationMain")

assemblyJarName in assembly := "tlcockpit.jar"
assemblyOutputPath in assembly := file("jar/tlcockpit.jar")

// sbt-assembly 2.x merge strategy
import AssemblyModule.MergeStrategy
import sbtassembly.PathList
assemblyMergeStrategy in assembly := {
  case PathList("module-info.class", xs @ _*) => MergeStrategy.discard
  case x =>
    val oldStrategy = (assemblyMergeStrategy in assembly).value
    oldStrategy(x)
}

// for scalafx
fork := true
